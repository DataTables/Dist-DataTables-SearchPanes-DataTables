<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>2.3.5</version>
        <id>datatables.net-searchpanes-dt</id>
        <description>This is SearchPanes for DataTables with styling for [DataTables](https://datatables.net/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>SearchPanes  search  filtering   Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-searchpanes" version="3.0.0-beta.1"/>
            <dependency id="datatables.net-dt" version="^3"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/searchPanes.dataTables.js" target="content\Scripts"/>
        <file src="js/searchPanes.dataTables.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.dataTables.min.js" target="content\Scripts"/>
        <file src="js/searchPanes.dataTables.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.dataTables.min.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.dataTables.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.dataTables.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.dataTables.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/searchPanes.dataTables.css" target="content\Content"/>
        <file src="css/searchPanes.dataTables.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/searchPanes.dataTables.min.css" target="content\Content"/>
        <file src="css/searchPanes.dataTables.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
